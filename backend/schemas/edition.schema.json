{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Edizione TheTomTimes",
  "type": "object",
  "additionalProperties": false,
  "required": ["date", "title", "featured", "stories"],
  "properties": {
    "date": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "title": { "$ref": "#/$defs/text" },
    "kind": { "enum": ["demo", "rss"] },
    "featured": { "$ref": "#/$defs/story" },
    "stories": { "type": "array", "items": { "$ref": "#/$defs/story" } },
    "videos": { "type": "array", "items": { "$ref": "#/$defs/video" } }
  },
  "$defs": {
    "text": {
      "type": "string",
      "allOf": [
        { "pattern": "\\S" },
        { "not": { "pattern": "[\\u0000-\\u001f\\u0085\\u2028\\u2029]" } }
      ]
    },
    "image": { "type": "string", "pattern": "^img/(?:[a-zA-Z0-9_-]+/)*[a-zA-Z0-9_-]+\\.(?:webp|avif|png|jpg|jpeg|gif)$" },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "category", "summary"],
      "properties": {
        "title": { "$ref": "#/$defs/text" },
        "category": { "$ref": "#/$defs/text" },
        "summary": { "$ref": "#/$defs/text" },
        "image": { "$ref": "#/$defs/image" },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "source_name": { "$ref": "#/$defs/text" },
        "original_url": { "type": "string", "format": "uri", "pattern": "^https?://" },
        "published_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      }
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "category", "summary", "image", "source"],
      "properties": {
        "title": { "$ref": "#/$defs/text" },
        "category": { "$ref": "#/$defs/text" },
        "summary": { "$ref": "#/$defs/text" },
        "image": { "$ref": "#/$defs/image" },
        "source": {
          "type": "string",
          "pattern": "^video/(?:[a-zA-Z0-9_-]+/)*[a-zA-Z0-9_-]+\\.mp4$"
        }
      }
    }
  }
}
